{
  "compilerOptions": {
    "target": "ES6",
    "module": "esnext",
    "strict": true,
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": false,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": [
    "*.ts",
    "typescript/controllerMappings.ts",
    "typescript/gamepadContextManager.ts",
    "typescript/gamepadService.ts",
    "typescript/gamepadServiceModel.ts",
    "typescript/gamepadUtils.ts",
    "typescript/pages/homePage.ts",
    "typescript/pages/styleIsolationPage.ts",
    "typescript/pages/examplePage.ts",
    "typescript/pages/debugPage.ts",
    "typescript/pages/exampleAutoInitPage.ts",
    "typescript/pages/exampleMenuPage.ts"
  ],
  "exclude": ["node_modules"]
} 