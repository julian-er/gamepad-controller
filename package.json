{
  "name": "gamepad-controller",
  "version": "1.0.0",
  "description": "Gamepad navigation controller with TypeScript support.",
  "main": "dist/index.cjs.js",
  "module": "dist/index.es.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "INTEGRATION_GUIDE.md",
    "QUICK_REFERENCE.md",
    "USAGE_GUIDE.md"
  ],
  "scripts": {
    "build": "npm i && vite build",
    "build:types": "tsc --emitDeclarationOnly",
    "serve": "npx http-server . -c-1 -o pages/home-page",
    "start": "npm i && npm run build && npm run serve",
    "example-test": "rm -rf dist && npm i && npm run build && npm pack && cd examples && npm i && npm run dev"
  },
  "devDependencies": {
    "http-server": "^14.1.1",
    "typescript": "^5.0.0",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4"
  }
}
